# Database Configuration
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_NAME=your_db_name

# User Credentials
TSEL_ADMIN_PASSWORD=your_secure_tsel_password
ENOM_USER_PASSWORD=your_secure_enom_password

# Other configurations...
FLASK_APP=<your_flask_app_here>
SQLALCHEMY_DATABASE_URI = <your_database_uri_here>
MAPBOX_TOKEN=<your_mapbox_token_here>
FLASK_SECRET_KEY=<Flask secret key here>
FLASK_ENV=<development or staging or production>

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_GROUP_ID=your_group_chat_id_here  # Optional
GROUP_2_ALARM_BROADCAST_ID=<listening_from_group_id> # Optional, listening from
GROUP_1_TESTING_ID=<your_group_id> # Optional, testing group
ADMIN_USER_IDS=<comma_separated_admin_user_ids>
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook  # For webhook mode
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret  # For webhook security